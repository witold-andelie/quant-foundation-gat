    elementType: image
    bounds: [60, 130, 760, 380]
    src: "D:/AI_Models/quant-alpha-foundation/paper/presentation/images/att_neighbour_weight.png"
    fit:
      mode: contain
  - elementId: figure-caption
    elementType: text
    bounds: [60, 515, 760, 40]
