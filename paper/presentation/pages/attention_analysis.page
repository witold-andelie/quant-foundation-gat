pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: badge
    elementType: text
    bounds: [60, 40, 300, 20]
    content:
      style: "$badge"
      align: [left, middle]
      wrap: false
      text: |
        <p>EQUITY TRACK RESULTS</p>
  - elementId: title
    elementType: text
    bounds: [60, 65, 900, 40]
