    elementType: table
    bounds: [660, 130, 560, 270]
    style: "$default"
    columnWidths: [0.32, 0.18, 0.20, 0.30]
    rowHeights: [0.16, 0.14, 0.14, 0.14, 0.14, 0.14, 0.14]
    rows:
      - - content:
            text: |
              <p>Predictor</p>
        - content:
            text: |
              <p>Skill</p>
        - content:
            text: |
              <p>Rank IC</p>
        - content:
            text: |
              <p>Note</p>
      - - content:
            text: |
              <p>persistence</p>
        - content:
            text: |
              <p>0.000</p>
        - content:
            text: |
              <p>0.637</p>
        - content:
            text: |
              <p>tomorrow = today</p>
      - - content:
            text: |
              <p>seasonal_naive</p>
        - content:
            text: |
              <p>0.000</p>
        - content:
            text: |
              <p>0.637</p>
        - content:
            text: |
              <p>diurnal carry</p>
      - - content:
            text: |
              <p>no_graph_ridge</p>
        - content:
            text: |
              <p>0.224</p>
        - content:
            text: |
              <p>0.636</p>
        - content:
            text: |
              <p>own drivers</p>
      - - content:
            text: |
