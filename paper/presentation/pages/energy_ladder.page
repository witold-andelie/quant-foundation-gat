pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: badge
    elementType: text
    bounds: [60, 40, 300, 20]
    content:
      style: "$badge"
      align: [left, middle]
      wrap: false
      text: |
        <p>ENERGY TRACK RESULTS</p>
  - elementId: title
    elementType: text
    bounds: [60, 65, 900, 40]
    content:
      style: "$pageTitle"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>Forecasting Skill Ladder: Node-Level Price</strong></p>
  - elementId: divider
    elementType: shape
    bounds: [60, 115, 1160, 0]
    shapeName: straightConnector1
    border:
      style: solid
      width: 1
      color: "$midGray"
  - elementId: figure
    elementType: image
    bounds: [60, 130, 560, 380]
    src: "D:/AI_Models/quant-alpha-foundation/paper/presentation/images/energy_ladder.png"
    fit:
      mode: contain
  - elementId: figure-caption
    elementType: text
    bounds: [60, 515, 560, 30]
    content:
      fontSize: 14
      color: "$darkGray"
      fontFamily: "QuattrocentoSans"
      lineHeight: 1.3
      align: [left, middle]
      text: |
        <p>Each rung adds exactly one ingredient. The graph's +0.131 enters below any learning.</p>
