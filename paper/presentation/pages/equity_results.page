    columnWidths: [0.22, 0.28, 0.50]
    rowHeights: [0.16, 0.14, 0.14, 0.14, 0.14, 0.14, 0.14]
    rows:
      - - content:
            text: |
              <p>Metric</p>
        - content:
            text: |
              <p>Value</p>
        - content:
            text: |
              <p>Note</p>
      - - content:
            text: |
              <p>Gates passed</p>
        - content:
            text: |
              <p><strong>3 / 4</strong></p>
        - content:
            text: |
              <p>Uniqueness + Consistency + Robustness pass; Value-added fails</p>
      - - content:
            text: |
              <p>Attention value-add</p>
        - content:
            text: |
              <p><strong>30 / 30</strong> seeds positive</p>
        - content:
            text: |
              <p>vs uniform anchor (no learned attention)</p>
      - - content:
            text: |
              <p>Best validation IC</p>
        - content:
            text: |
              <p>0.0756</p>
        - content:
            text: |
              <p>Best-by-valid-IC checkpoint selection</p>
      - - content:
            text: |
