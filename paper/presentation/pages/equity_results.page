        - content:
            text: |
              <p>Correlation top-k + sectors</p>
        - content:
            text: |
              <p>49 US names, 2021–2026, static graph</p>
  - elementId: big-number-1-bg
    elementType: shape
    bounds: [60, 420, 360, 110]
