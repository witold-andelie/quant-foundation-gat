pageType: content
background:
  type: solid
  color: "$background"
elements:
  - elementId: badge
    elementType: text
    bounds: [60, 40, 300, 20]
    content:
      style: "$badge"
      align: [left, middle]
      wrap: false
      text: |
        <p>EQUITY TRACK RESULTS</p>
  - elementId: title
    elementType: text
    bounds: [60, 65, 900, 40]
    content:
      style: "$pageTitle"
      align: [left, middle]
      wrap: false
      text: |
        <p><strong>Headline Evidence: 30 of 30 Seeds Positive</strong></p>
  - elementId: divider
    elementType: shape
    bounds: [60, 115, 1160, 0]
    shapeName: straightConnector1
    border:
      style: solid
      width: 1
      color: "$midGray"
  - elementId: table
    elementType: table
    bounds: [60, 130, 1160, 270]
